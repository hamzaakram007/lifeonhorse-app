# Supabase (required)
# Get from: https://supabase.com/dashboard/project/ebgzqmnewtdippegphou/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://ebgzqmnewtdippegphou.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Server-only — NEVER expose to browser
SUPABASE_SERVICE_ROLE_KEY=your_service_role_jwt_here

# App URL (used for auth redirects and metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: production/staging labels
NEXT_PUBLIC_APP_ENV=development
