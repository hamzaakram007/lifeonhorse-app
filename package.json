{
  "name": "lifeonhorse-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "node --env-file=.env.local scripts/seed-demo.mjs",
    "seed:users": "node --env-file=.env.local scripts/seed-users.mjs",
    "seed:all": "node --env-file=.env.local scripts/seed-users.mjs && node --env-file=.env.local scripts/seed-demo.mjs",
    "seed:cleanup": "node --env-file=.env.local scripts/cleanup-demo.mjs",
    "seed:photos": "node --env-file=.env.local scripts/update-demo-photos.mjs",
    "seed:products": "node --env-file=.env.local scripts/seed-products.mjs",
    "seed:blog-photos": "node --env-file=.env.local scripts/update-blog-photos.mjs",
    "seed:club-photos": "node --env-file=.env.local scripts/update-demo-photos.mjs",
